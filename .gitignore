# KiCad 8 Git Ignore Rules

# Temporary and auto-save files
*.kicad_prl
*.kicad_pcb-bak
*.kicad_sch-bak
*-bak
*.bak
_autosave-*
*.tmp
*~

# DRC, ERC, and log files
*.000
*.rpt
*.log
*-save.pro
*-save.kicad_pcb
fp-info-cache

# Output and Gerber files (store in separate release zips or export scripts)
gerbers/
outputs/
*.zip
.history/
*/.history/
