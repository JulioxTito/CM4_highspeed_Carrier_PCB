	(text "CM4 MINI-DESKTOP PC — MASTER SYSTEM ARCHITECTURE"
		(at 26.0 28.0 0)
		(effects (font (size 2.54 2.54) bold) (justify left bottom))
		(uuid "11111111-0001-0001-0001-000000000001")
	)
	(text "4-Layer Controlled-Impedance Carrier Board for Raspberry Pi Compute Module 4 | Julio — ECE Hardware Portfolio"
		(at 26.0 34.0 0)
		(effects (font (size 1.5 1.5) italic) (justify left bottom))
		(uuid "11111111-0001-0001-0001-000000000002")
	)

	(text "• Primary Power In: 5V / 3A DC via USB-C Receptacle\n• Buck Regulator: 3.3V / 2A (Silergy SY8089AAAC)\n• Protection: P-FET Reverse Polarity & TVS ESD Diode\n• High-Capacitance Decoupling Power Planes"
		(at 30.0 52.0 0)
		(effects (font (size 1.27 1.27)) (justify left top))
		(uuid "11111111-0001-0001-0001-000000000003")
	)

	(text "• RTC Controller: NXP PCF85063AT (I2C Interface)\n• Timekeeping Crystal: 32.768 kHz Quartz Oscillator\n• Battery Backup: CR1220 Coin Cell + BAT54C Diode\n• Preserves System Wall-Clock Time When Powered Off"
		(at 30.0 105.0 0)
		(effects (font (size 1.27 1.27)) (justify left top))
		(uuid "11111111-0001-0001-0001-000000000004")
	)

	(text "• Mezzanine 2: Hirose DF40C-100DS-0.4V (Pins 101-200)\n• Video Output: Standard Full-Size HDMI 0 Receptacle\n• Signal Integrity: 100-Ohm Differential TMDS Pairs\n• Protection: Low-Capacitance TVS Clamping Diodes\n• Level Shifter: 3.3V to 5V DDC I2C Translator"
		(at 112.0 52.0 0)
		(effects (font (size 1.27 1.27)) (justify left top))
		(uuid "11111111-0001-0001-0001-000000000005")
	)

	(text "• Mezzanine 1: Hirose DF40C-100DS-0.4V (Pins 1-100)\n• Network Interface: 10/100/1000 Gigabit RJ45 MagJack\n• System Storage: MicroSD Socket (CM4 Lite OS Boot)\n• Power Management: SD_PWR_ON High-Side Switch\n• Visual Diagnostics: PWR (Red) & ACT (Green) LEDs"
		(at 112.0 105.0 0)
		(effects (font (size 1.27 1.27)) (justify left top))
		(uuid "11111111-0001-0001-0001-000000000006")
	)

	(text "• Hub IC: Microchip USB2514B 4-Port Controller\n• Downstream Ports: 4x USB 2.0 Type-A (Dual Stacked)\n• Clock Reference: 24.000 MHz Crystal Oscillator\n• Port Protection: AP2191 High-Side Power Switches\n• Interconnect: 90-Ohm Differential USB Pairs"
		(at 202.0 52.0 0)
		(effects (font (size 1.27 1.27)) (justify left top))
		(uuid "11111111-0001-0001-0001-000000000007")
	)

	(text "HARDWARE SPECS & HIGHLIGHTS\n-----------------------------------------------------\n• Form Factor: Credit-Card (~85 mm x 56 mm)\n• PCB Target: 4-Layer (JLC04161H Stackup)\n• Layers: Sig / Solid GND / Power / Sig\n• Target OS: Raspberry Pi OS / RetroPie\n• Schematics Status: 100% Synchronized (KiCad 10)"
		(at 198.0 98.0 0)
		(effects (font (size 1.3 1.3)) (justify left top))
		(uuid "11111111-0001-0001-0001-000000000008")
	)

)